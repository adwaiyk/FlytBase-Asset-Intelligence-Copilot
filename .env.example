# OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Main agent model and fallbacks (comma separated), all served through OpenRouter
COPILOT_MODEL=google/gemma-4-31b-it:free
COPILOT_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free
# One or more dataset roots (each contains sample-data/ or fleet/+assets/), comma separated
COPILOT_DATA_DIRS=data/flytbase-dataset/sample-data
# "Today" for the dataset. Empty = last inspection date + 1 day
COPILOT_AS_OF=
# Password every user gets on first start (they can change it in the sidebar)
COPILOT_DEFAULT_PASSWORD=flytbase2026
COPILOT_DB=copilot.db
